# ─────────────────────────────────────────────────────────────
#  Sri Veludaiyan Nursery API — environment template
#  Copy this file to `.env` and replace the placeholder values.
#  `.env` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database. Either a local server:
#   mongodb://127.0.0.1:27017/plant_garden
# or a MongoDB Atlas cluster (Atlas -> Connect -> Drivers -> copy the string,
# replace <password>, and put the database name before the "?"):
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/plant_garden?retryWrites=true&w=majority
# Percent-encode any of  @ : / ? # [ ]  that appear in the password.
# Verify it with:  npm run check-db
MONGODB_URI=mongodb://127.0.0.1:27017/plant_garden

# Auth. JWT_SECRET must be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=2h

# Admin account. Seeded into MongoDB on first boot; the password is
# stored only as a bcrypt hash and is never sent to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Comma-separated list of browser origins allowed to call this API
CLIENT_URL=http://localhost:5173

# Public base URL of this API. Only used to label the startup banner —
# image paths are stored relative and resolved by the front end.
SERVER_URL=http://localhost:5000

# Upload limits
MAX_UPLOAD_SIZE_MB=5
